{
  "name": "httpreq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "monaco-editor": "0.53.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@httpreq/web",
    "dev:web": "npm run dev --workspace=@httpreq/web",
    "dev:desktop": "npm run dev --workspace=@httpreq/desktop",
    "build": "npm run typecheck && npm run build:web && npm run build:desktop",
    "build:web": "npm run build --workspace=@httpreq/web",
    "build:desktop": "npm run build --workspace=@httpreq/desktop",
    "package:desktop": "npm run build && npm run package --workspace=@httpreq/desktop",
    "release:check": "node apps/desktop/scripts/release-info.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:set": "npm version --workspaces --include-workspace-root --no-git-tag-version"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "monaco-editor": "0.53.0"
  }
}
